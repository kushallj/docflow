DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://docflow:docflow@localhost:5432/docflow
# REDIS_URL=redis://localhost:6379/0     # unset: OCR runs inline in the web process
OCR_ENGINE=paddleocr
OCR_LANG=en
OCR_DET_MODEL=PP-OCRv5_mobile_det
# MEDIA_ROOT=/var/lib/docflow/media
# Front ends allowed to call the API from a browser (Flutter web build etc.)
# CORS_ALLOWED_ORIGINS=https://rules.example.com
